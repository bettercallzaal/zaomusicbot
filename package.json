{
  "name": "zao-music-bot",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "bot",
    "web",
    "shared"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=bot",
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "deploy-commands": "npm run deploy-commands --workspace=bot",
    "lavalink": "export $(grep -v '^#' bot/.env | xargs) && cd lavalink && java -jar Lavalink.jar",
    "start": "npm run start --workspace=bot"
  },
  "dependencies": {
    "lavalink-client": "^2.9.7"
  }
}
